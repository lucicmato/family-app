# Template of variable NAMES only — never put real values in this file.
# Copy to .env.local (git-ignored) for local development, and set the same
# names in the Vercel dashboard for production.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time:
# they are public by design, and changing them requires a redeploy.
# Everything without that prefix stays on the server.

# --- Supabase ---
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated Google emails allowed to sign in. Checked in
# app/auth/callback/route.ts, alongside the dashboard signup restriction.
ALLOWED_EMAILS=

# --- Push notifications (VAPID) ---
# Generate the pair once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- AI shopping-list grouping (Claude) ---
# console.anthropic.com -> API Keys. Server-only. Without it, new shopping
# items still save fine, they just sort to the end of the list.
ANTHROPIC_API_KEY=

# --- Secret: bypasses Row Level Security ---
# Full read/write over the entire database. Server-only, never NEXT_PUBLIC_,
# never imported from a "use client" component. If it ever leaks, rotate it in
# the Supabase dashboard — removing it from git history is not enough.
SUPABASE_SERVICE_ROLE_KEY=
